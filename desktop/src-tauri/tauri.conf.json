{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Okulos",
  "version": "0.1.0",
  "identifier": "tr.okulos.desktop",
  "build": {
    "beforeBuildCommand": "cd .. && bun run build",
    "frontendDist": "../../.output/public"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Okulos",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
